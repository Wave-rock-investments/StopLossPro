# StopLossPro Licensing API — environment variable NAMES only.
# Copy to .env for local dev. NEVER commit .env. NEVER put real values here.

STOPLOSS_ENV=development
STOPLOSS_DEBUG=true

# Local dev may use SQLite. PRODUCTION MUST USE POSTGRESQL —
# SQLite cannot enforce SELECT ... FOR UPDATE, which the
# one-active-session guarantee depends on.
STOPLOSS_DATABASE_URL=sqlite:///./stoploss_dev.db
# STOPLOSS_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/stoploss

# Ed25519 signing keypair, PEM, base64-encoded. Signs authorization GRANTS only.
# Generate with:  python -m app.keygen
# The PRIVATE key is server-only and must NEVER ship in a client build.
STOPLOSS_SIGNING_PRIVATE_KEY_B64=
STOPLOSS_SIGNING_PUBLIC_KEY_B64=
STOPLOSS_SIGNING_KEY_ID=k1

# Independent secret that encrypts MFA (TOTP) secrets at rest. Deliberately
# NOT the signing key above — rotating one must not force rotating the other.
# Generate with:  python -m app.keygen  (prints both blocks)
# Server-only. Never ships in a client build.
STOPLOSS_TOTP_ENCRYPTION_KEY_B64=

STOPLOSS_GRANT_TTL_SECONDS=180
STOPLOSS_HEARTBEAT_INTERVAL_SECONDS=90
STOPLOSS_OFFLINE_GRACE_SECONDS=259200

STOPLOSS_MAX_FAILED_LOGINS=5
STOPLOSS_LOCKOUT_SECONDS=900

STOPLOSS_CORS_ORIGINS=
