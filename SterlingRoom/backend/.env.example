# Sterling_Room API — variable NAMES only. Never commit real values.
# Copy to .env for local development, or set these as real environment
# variables / secrets on whatever host runs this in production.

STERLING_ENV=development
STERLING_DEBUG=false

# Production: postgresql+psycopg://user:pass@host:5432/sterling_room
STERLING_DATABASE_URL=sqlite:///./sterling_room_dev.db

# Comma-separated shared-secret bearer tokens the StopLossPro adapter (and
# any other trusted caller) presents on POST /calls. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
STERLING_ADAPTER_API_KEYS=

# Telegram — the bot (@SterlingroomBot) and both production channels
# (Sterling_Room / SterlingRoom_Premium) already exist and are finalized
# (2026-08-16). No separate results variable: verified results post to
# TELEGRAM_FREE_CHAT_ID itself — see DEPLOYMENT.md §4. Fill the values
# below into the real production secret manager, never into this repo.
STERLING_TELEGRAM_BOT_TOKEN=
STERLING_TELEGRAM_FREE_CHAT_ID=
STERLING_TELEGRAM_PREMIUM_CHAT_ID=
STERLING_TELEGRAM_CHANNEL_LINK=

# Interactive bot (Phase 4) — shown by the FREE ACCESS / SUPPORT buttons.
STERLING_TELEGRAM_FREE_CHANNEL_LINK=
STERLING_TELEGRAM_SUPPORT_CONTACT=
# Secret path segment for POST /telegram/webhook/<this>. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Required
# before registering the webhook URL with Telegram (see DEPLOYMENT.md) —
# without it the webhook route always 404s (fails closed).
STERLING_TELEGRAM_WEBHOOK_SECRET=

# Admin dashboard (Phase 7). ADMIN_BOOTSTRAP_TOKEN is only needed once, to
# create the first admin account via POST /admin/bootstrap — safe to leave
# set afterward (the endpoint refuses once any admin account exists) but
# rotating/clearing it post-bootstrap is still good practice.
STERLING_ADMIN_BOOTSTRAP_TOKEN=
# Signs admin session cookies. Generate with the same secrets.token_urlsafe
# command as above — must be an INDEPENDENT value from ADAPTER_API_KEYS and
# ADMIN_BOOTSTRAP_TOKEN, not reused. Required in production.
STERLING_ADMIN_SESSION_SECRET=

# Which app/payments.py PaymentProvider is active. "manual" (cash/crypto,
# admin-verified via /admin/payments) is the only implementation that
# exists — see app/payments.py's module docstring before changing this.
STERLING_PAYMENT_PROVIDER=manual

STERLING_API_PREFIX=/api/v1
STERLING_CORS_ORIGINS=
